# Gemini image generation. If GEMINI_API_KEY is set, the provider calls the
# Generative Language REST API directly (recommended). If unset, it falls back to the
# Gemini CLI + Nano Banana extension (Google login, no key).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Higgsfield image generation runs through the official CLI against your own
# Higgsfield plan (Starter/Plus/Ultra) — no API key. One-time setup:
#   npm i -g @higgsfield/cli
#   higgsfield auth login            (browser sign-in)
#   higgsfield workspace set <id>    (if it asks you to pick a billing workspace)
# HIGGSFIELD_BIN only needs setting if the CLI isn't named "higgsfield"/"hf" on PATH.
HIGGSFIELD_BIN=
HIGGSFIELD_MODEL=nano_banana_flash
